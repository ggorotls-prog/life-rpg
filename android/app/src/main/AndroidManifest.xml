<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 서버(rpg_ 함수)·새 버전 확인 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 밤 9시 30분 알림, 재부팅 뒤 다시 걸기 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 첫 화면 「오늘」: 폰에 들어와 있는 구글 캘린더 일정 읽기(업무 기록 캘린더 위젯과 같음) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 스스로 업데이트(기록 앱과 같은 방식) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- 📋 업무 기록(2026-11-16, 업무 기록 앱과 같은 권한): 할 일 알림 시간에 정확히 울리기 · 위젯 🎙 녹음 · 통화 녹음 파일 가져오기 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- ⛪ 영성 기록(2026-11-16, 영성 기록 앱과 같은 권한): 7up 7분 타이머 알람 소리·진동 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 👥 관계 기록(2026-11-16, 관계 기록 앱과 같은 권한): 통화가 끝났는지(번호는 안 읽음) · 통화 기록(번호·방향·시각·길이만, 녹음·내용 안 읽음) ·
         연락처(제외 목록·알림 이름) · 통화가 끝나면 화면 아래 작은 창으로 묻기 -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- 이름 맞추기(2026-11-20, relkit Names): 등록한 사람의 이름을 폰 연락처와 서로 맞춘다(이름 바꾸기·새 연락처. 지우는 일은 없음) -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 🏘 잠금화면 앞에 마을(2026-11-18): 화면 꺼짐을 지켜보는 늘 떠 있는 알림 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 아빠 집: 영성 기록 앱을 열려면 그 앱이 보여야 한다(안드로이드 11+) -->
    <queries>
        <!-- 🎤 잠금화면 앞 ＋ 수집: 폰의 음성 인식 서비스를 찾으려고(2026-11-20) -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="app.personalrecord" />
        <package android:name="app.todohub" />
        <package android:name="app.faithbudget" />
        <!-- 건강 기록 단독 앱이 깔려 있으면 아침·밤 알림을 그 앱에 맡긴다 -->
        <package android:name="app.liferoom" />
        <!-- 기록 앱 단독판이 깔려 있으면 알림·통화 모으기를 그 앱에 맡긴다 -->
        <package android:name="app.relrecord" />
        <!-- 관계 기록: 익시오를 찾아 열려고(녹음 글 복사) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:label="라이프 RPG"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
        android:supportsRtl="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|uiMode|density"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 앱 아이콘 길게 누르기·원핸드(One hand) 「바로가기」에 뜨는 「할 일 적기」(2026-11-19 룡, 업무 기록 앱과 같은 방식) -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- 홈 화면 위젯(Lv·오늘 일정·할 일)은 없앴다(2026-11-19 룡 「잠금화면 앞에 마을이 있으니 안 써」). 놓아 둔 위젯은 빈 칸이 되니 길게 눌러 지운다.
             Widget·TodayService·WidgetAction 코드는 남겨 둔다(지갑 빠른 기록 창을 여는 길 Widget.walletIntent를 마을이 쓴다) -->

        <!-- 밤 9시 30분 알림 · 재부팅·업데이트 뒤 다시 걸기 -->
        <receiver android:name=".Daily" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".Daily$Job"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver android:name=".UpdateReceiver" android:exported="false" />

        <!-- 🏘 잠금화면 앞에 마을(2026-11-18 룡): 화면이 꺼질 때 마을 화면을 잠금화면 위에 올려 둔다. 기본은 꺼짐 -->
        <service android:name=".LockFront" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="잠금화면 위에 이 앱의 첫 화면을 보여 주려고 화면 꺼짐을 지켜본다" />
        </service>
        <receiver android:name=".LockFront$Boot" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 🏠 집 = 건강 기록 화면 그 자체(2026-11-15 룡). 건강 기록 앱 MainActivity와 같은 설정 -->
        <activity
            android:name=".HealthActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 건강 기록 아침 8시·밤 10시 알림(건강 기록 앱이 없을 때만 울림), 재부팅·업데이트 뒤 다시 걸기 -->
        <receiver android:name=".HealthReminder" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 취침 잠금: 건강 기록 앱 LockService와 같은 것. 룡이 설정 > 접근성에서 한 번 켠다 -->
        <service
            android:name=".LockService"
            android:exported="true"
            android:label="라이프 RPG 취침 잠금 (건강 기록)"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/health_lock_service" />
        </service>

        <!-- 👛 지갑 = 재정 기록(2026-11-15 2단계). 원본 한 벌 finkit: 장부 화면 · 빠른 기록 창 · 「+ 수입 | − 지출」 위젯 -->
        <activity
            android:name=".WalletActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 빠른 기록 창(재정 기록 앱 QuickActivity와 같은 설정). exported라 One hand 제스처에서 바로 열 수 있다 -->
        <activity
            android:name=".WalletQuickActivity"
            android:exported="true"
            android:label="빠른 기록"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/FinQuick" />

        <receiver android:name=".WalletWidget" android:exported="false" android:label="재정 기록">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/fin_widget_info" />
        </receiver>

        <!-- 📋 업무 기록 = 업무 기록 앱 그 자체(2026-11-16). 원본 한 벌 workkit, 설정은 업무 기록 앱 manifest와 같게 -->
        <activity
            android:name=".WorkApp$Screen"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.liferpg.work"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- ＋ 할 일 적기 작은 창. exported라 One hand 제스처에서 바로 열 수 있다 -->
        <activity
            android:name=".WorkApp$Quick"
            android:exported="true"
            android:label="할 일 적기"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@style/WorkQuickAdd" />
        <!-- 잠금화면 앞 마을의 ＋ 수집 말풍선(2026-11-19): 같은 적기 창을 잠금 위에. 사진 없이 적기만 -->
        <activity
            android:name=".WorkApp$LockQuick"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@style/WorkQuickAdd" />
        <activity
            android:name=".WorkApp$Confirm"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <receiver android:name=".WorkApp$TaskWidget" android:exported="false" android:label="내 할 일">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/work_task_widget_info" />
        </receiver>
        <service android:name=".WorkApp$TaskList" android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <receiver android:name=".WorkApp$CalWidget" android:exported="false" android:label="오늘 일정·할 일">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/work_cal_widget_info" />
        </receiver>
        <service android:name=".WorkApp$CalList" android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
        <activity
            android:name=".WorkApp$CalOpen"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- 할 일 알림 시간·하루 알림, 재부팅 뒤 다시 걸기(업무 기록 앱이 같이 깔려 있으면 알림은 그 앱만) -->
        <receiver android:name=".WorkApp$Alarm" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service android:name=".WorkApp$Sync" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".WorkApp$RecordAlert" android:exported="false" />
        <!-- 녹음할 미팅 알림(2026-11-18) -->
        <receiver android:name=".WorkApp$MeetAlert" android:exported="false" />
        <activity
            android:name=".WorkApp$Meet"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/WorkQuickAdd" />
        <activity
            android:name=".WorkApp$RecordStart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/WorkQuickAdd" />
        <service android:name=".WorkApp$Record" android:exported="false"
            android:foregroundServiceType="microphone" />
        <service android:name=".WorkApp$RecordUpload" android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <service android:name=".WorkApp$Push" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- ⛪ 아빠 집 영성 기록 = 영성 기록 앱 그 자체(2026-11-16). 원본 한 벌 spiritkit, 설정은 영성 기록 앱 manifest와 같게 -->
        <activity
            android:name=".SpiritApp$Screen"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.liferpg.spirit"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <!-- 감사·칭찬·SOC·기도제목 작은 적기 창. exported라 One hand 제스처에서 바로 열 수 있다 -->
        <activity
            android:name=".SpiritApp$Quick"
            android:exported="true"
            android:label="영성 기록 적기"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"
            android:theme="@style/SpiritQuickAdd" />
        <receiver android:name=".SpiritApp$Widget" android:exported="false" android:label="영성 기록">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/spirit_widget_info" />
        </receiver>
        <!-- 묵상 알림 시각 + 7분 타이머 + 폰 켤 때 다시 맞추기(영성 기록 앱이 같이 깔려 있으면 묵상 알림은 그 앱만) -->
        <receiver android:name=".SpiritApp$Reminder" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name=".SpiritApp$TimerRing" android:exported="false" android:foregroundServiceType="mediaPlayback" />

        <!-- 👥 이웃 = 관계 기록 앱 그 자체(2026-11-16). 원본 한 벌 relkit, 설정은 관계 기록 앱 manifest와 같게 -->
        <activity
            android:name=".RelApp$Screen"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="app.liferpg.rel"
            android:windowSoftInputMode="adjustResize" />
        <!-- 통화 끝나면 뜨는 작은 창: 이름·영역 고르고 바로 저장 -->
        <activity
            android:name=".RelApp$Ask"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar"
            android:taskAffinity="app.liferpg.ask"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />
        <!-- 통화가 끝나면 통화 기록 읽기 예약(관계 기록 앱이 같이 깔려 있으면 그 앱만) -->
        <receiver android:name=".RelApp$Call" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
        <receiver android:name=".RelApp$AskAlert" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".RelApp$CallWork"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 파일 넘기기: 건강 기록 사진 찍기(카메라가 찍은 파일 넘겨받기) · 영성 기록 묵상 이미지 공유. 길은 rpg_files에 둘 다 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/rpg_files" />
        </provider>
        <!-- 은행·카드 알림 읽기(finkit)의 이름만 바꾼다(2026-11-19 룡): 폰 「알림 읽기」 목록에서 재정 기록 단독 앱과 이름이 같아 다른 앱 것을 켜기 쉬웠다 -->
        <service
            android:name="app.recordkit.fin.FinNotice"
            android:label="라이프 RPG · 은행·카드 알림 → 기록할까요?"
            tools:replace="android:label" />
    </application>
</manifest>
