<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 = 마을 첫 화면을 줄인 것: 맨 위 Lv·막대·오늘 n칸·🏠 👛 ⛪, 아래 오늘 일정 + 할 일 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg" android:padding="10dp">
    <LinearLayout android:id="@+id/head" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/lv" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Lv" android:textSize="17sp" android:textStyle="bold" android:textColor="#3B5B8C" />
        <ProgressBar android:id="@+id/bar" style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="6dp"
            android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
            android:max="100" android:progress="0" android:progressTint="#3B5B8C" android:progressBackgroundTint="#E4E2DB" />
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textSize="11sp" android:textColor="#6B6A64" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/bHome" style="@style/WBtn" android:text="🏠" />
        <TextView android:id="@+id/bWallet" style="@style/WBtn" android:text="👛" />
        <TextView android:id="@+id/bFather" style="@style/WBtn" android:text="⛪" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="6dp">
        <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="#00000000" android:dividerHeight="0dp" />
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:text="불러오는 중…" android:textColor="#9A9890" android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
